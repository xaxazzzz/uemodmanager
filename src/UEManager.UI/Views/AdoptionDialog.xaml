<UserControl x:Class="UEManager.UI.Views.AdoptionDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:UEManager.UI"
             xmlns:vm="clr-namespace:UEManager.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AdoptionDialogViewModel}">
    <Border Style="{StaticResource Dialog}" Width="660">
        <DockPanel>

            <!-- Header -->
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Style="{StaticResource Text.Overline}" Text="{ui:Loc 'Adopt mods', Tracked=True}" />
                <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Title}" Text="{ui:Loc 'Mods installed by hand'}" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Small}" Text="{Binding Summary}" />
            </StackPanel>

            <!-- Buttons -->
            <DockPanel DockPanel.Dock="Bottom" Margin="0,22,0,0" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Text.Small}" Text="{Binding SelectionText}" />
                </StackPanel>
                <Button DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource Button.Primary}"
                        Content="{Binding AdoptText}" ui:Icon.Glyph="&#xE8B7;" Command="{Binding AdoptCommand}" IsDefault="True"
                        ToolTip="{ui:Loc 'The manager takes the ticked mods over: their files stay where they are, and from now on they are in your list.'}" />
                <Button DockPanel.Dock="Right" Content="{ui:Loc 'Cancel'}" Command="{Binding CancelCommand}" IsCancel="True" />
            </DockPanel>

            <ScrollViewer Margin="0,20,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- An explanation before the list -->
                    <TextBlock TextWrapping="Wrap" LineHeight="19" Style="{StaticResource Text.Body}"
                               Text="{ui:Loc 'These mods are already in the game, but the manager does not know them. Adopting copies each file into the manager\'s library and marks it as installed — nothing in the game moves or changes. Afterwards you can turn the mods off and on, update and uninstall them here.'}" />

                    <!-- Candidates -->
                    <TextBlock Margin="0,18,0,8" Style="{StaticResource Text.Caption}" Text="{ui:Loc 'Found in the game', Tracked=True}" />
                    <ItemsControl ItemsSource="{Binding Candidates}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:InstalledCandidateViewModel}">
                                <Border Margin="0,0,0,6" Padding="14,10" CornerRadius="2"
                                        Background="{StaticResource Brush.Field}" BorderBrush="{StaticResource Brush.Line}" BorderThickness="1">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                            <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Style="{StaticResource Text.Small}" Text="{Binding SizeText}" />
                                            <Border Style="{StaticResource Badge}">
                                                <TextBlock FontFamily="{DynamicResource Font.Label}" FontSize="11" Text="{Binding KindText}" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel>
                                            <CheckBox IsChecked="{Binding IsSelected}">
                                                <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Label}" />
                                            </CheckBox>
                                            <TextBlock Margin="26,4,0,0" FontSize="11.5" Foreground="{StaticResource Brush.TextDim}"
                                                       TextTrimming="CharacterEllipsis" Text="{Binding DestinationText}"
                                                       ToolTip="{Binding DestinationText}" />
                                            <TextBlock Margin="26,4,0,0" FontSize="11.5" Foreground="{StaticResource Brush.TextDim}"
                                                       TextTrimming="CharacterEllipsis" Text="{Binding FilesText}" />
                                            <!-- Not ticked at first: a DLL next to the game's exe belongs to some tool. -->
                                            <TextBlock Margin="26,4,0,0" FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource Brush.Warning}"
                                                       Text="{Binding UncertainHint}"
                                                       Visibility="{Binding IsUncertain, Converter={StaticResource Visible}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Small}" TextTrimming="None" TextWrapping="Wrap"
                               Text="{Binding IgnoredText}" Visibility="{Binding IgnoredText, Converter={StaticResource VisibleIfSet}}" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
