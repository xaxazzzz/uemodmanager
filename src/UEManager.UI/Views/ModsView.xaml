<UserControl x:Class="UEManager.UI.Views.ModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:UEManager.UI"
             xmlns:vm="clr-namespace:UEManager.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <UserControl.Resources>
        <!-- Column widths shared by the header and every row. -->
        <GridLength x:Key="Col.Status">124</GridLength>
        <GridLength x:Key="Col.Type">92</GridLength>
        <GridLength x:Key="Col.Integrity">136</GridLength>
        <GridLength x:Key="Col.Date">104</GridLength>
        <GridLength x:Key="Col.Actions">176</GridLength>
        <!-- What the table drops in a narrow window, so the mod's name keeps room; see ModsView.OnTableSizeChanged. -->
        <Visibility x:Key="Mods.WideOnly">Visible</Visibility>

        <!-- A mod's row: in the table, and for the recommended mod in its card above it. -->
        <DataTemplate x:Key="ModRow" DataType="{x:Type vm:ModItemViewModel}">
            <Border x:Name="Row" Padding="22,12" Background="Transparent"
                    BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{DynamicResource Col.Status}" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{DynamicResource Col.Type}" />
                        <ColumnDefinition Width="{DynamicResource Col.Integrity}" />
                        <ColumnDefinition Width="{DynamicResource Col.Date}" />
                        <ColumnDefinition Width="{DynamicResource Col.Actions}" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding Enabled, Mode=OneWay}"
                                  Command="{Binding ToggleCommand}" ToolTip="{ui:Loc 'Enable or disable'}" />
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Small}"
                                   Text="{Binding EnabledText}" Visibility="{DynamicResource Mods.WideOnly}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                        <Button Style="{StaticResource Button.Name}" Content="{Binding Name}"
                                Command="{Binding ShowDetailsCommand}" ToolTip="{ui:Loc 'Show the details of this mod and every file it placed'}" />
                        <TextBlock Margin="0,3,0,0" Style="{StaticResource Text.Small}" Text="{Binding Detail}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                    Visibility="{Binding HasRuntimeState, Converter={StaticResource Visible}}"
                                    ToolTip="{Binding RuntimeHint}">
                            <TextBlock Style="{StaticResource Text.Icon}" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{Binding RuntimeTone, Converter={StaticResource Tone}}" Text="{Binding RuntimeGlyph}" />
                            <TextBlock Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{Binding RuntimeTone, Converter={StaticResource Tone}}" Text="{Binding RuntimeText}" />
                        </StackPanel>
                        <Button Margin="0,4,0,0" Style="{StaticResource Button.Link}" Foreground="{StaticResource Brush.Danger}"
                                Content="{ui:Loc 'UE4SS reported errors at the last game start'}" Command="{Binding ShowUe4ssErrorsCommand}"
                                ToolTip="{ui:Loc 'Show the lines of the UE4SS log that name this mod'}"
                                Visibility="{Binding HasUe4ssErrors, Converter={StaticResource Visible}}" />
                    </StackPanel>

                    <Border Grid.Column="2" Style="{StaticResource Badge}">
                        <TextBlock FontFamily="{DynamicResource Font.Label}" FontSize="11" Text="{Binding KindText}" />
                    </Border>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                Background="Transparent" ToolTip="{Binding IntegrityHint}">
                        <TextBlock Style="{StaticResource Text.Icon}" FontSize="12"
                                   Foreground="{Binding IntegrityTone, Converter={StaticResource Tone}}" Text="{Binding IntegrityGlyph}" />
                        <TextBlock Margin="7,0,0,0" FontSize="12" VerticalAlignment="Center" Visibility="{DynamicResource Mods.WideOnly}"
                                   Foreground="{Binding IntegrityTone, Converter={StaticResource Tone}}" Text="{Binding IntegrityText}" />
                    </StackPanel>

                    <TextBlock Grid.Column="4" VerticalAlignment="Center" Style="{StaticResource Text.Small}" Visibility="{DynamicResource Mods.WideOnly}"
                               Text="{Binding InstalledText}" ToolTip="{Binding InstalledFullText}" />

                    <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Margin="0,0,4,0" Style="{StaticResource Button.Icon}" ui:Icon.Glyph="&#xE713;"
                                Command="{Binding EditSettingsCommand}" ToolTip="{Binding EditSettingsHint}"
                                ToolTipService.ShowOnDisabled="True"
                                Visibility="{Binding HasSettings, Converter={StaticResource Visible}}" />
                        <Button Margin="0,0,4,0" Style="{StaticResource Button.Icon}" ui:Icon.Glyph="&#xE7A7;"
                                Command="{Binding ResetSettingsCommand}" ToolTip="{ui:Loc 'Reset the settings to the ones the mod came with'}"
                                Visibility="{Binding CanResetSettings, Converter={StaticResource Visible}}" />
                        <Button Margin="0,0,4,0" Style="{StaticResource Button.Icon}" ui:Icon.Glyph="&#xE8FD;"
                                Command="{Binding ShowDetailsCommand}" ToolTip="{ui:Loc 'Show the files of this mod in their folders'}" />
                        <Button Style="{StaticResource Button.Icon}" ui:Icon.Glyph="&#xE838;"
                                Command="{Binding OpenFolderCommand}" ToolTip="{ui:Loc 'Open the manager\'s copy of this mod'}" />
                        <Button Margin="4,0,0,0" Style="{StaticResource Button.IconDanger}" ui:Icon.Glyph="&#xE74D;"
                                Command="{Binding UninstallCommand}" ToolTip="{ui:Loc 'Uninstall'}" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsBesideGameFiles}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.GameFilesRow}" />
                </DataTrigger>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.Hover}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>

        <!-- Header -->
        <Grid Margin="0,6,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Overline}" Text="{ui:Loc 'Collection', Tracked=True}" />
                <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Display}" Text="{ui:Loc 'Mods'}" />
                <Rectangle Width="200" Height="2" Margin="0,14,0,14" HorizontalAlignment="Left" Fill="{StaticResource Brush.Stroke}" />
                <TextBlock MaxWidth="640" HorizontalAlignment="Left" Style="{StaticResource Text.Body}"
                           Text="{ui:Loc 'A checksum is recorded for each file the manager places in the game. Disabling a mod removes only its own files, and only while they are unchanged.'}" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                <Button Style="{StaticResource Button.Primary}" Content="{ui:Loc 'Install from 7z/zip/rar…'}"
                        ui:Icon.Glyph="&#xE896;" Command="{Binding InstallFromArchiveCommand}" />
                <Button Margin="8,0,0,0" Content="{ui:Loc 'Install from folder…'}" ui:Icon.Glyph="&#xE8B7;" Command="{Binding InstallFromFolderCommand}" />
                <Button Margin="8,0,0,0" Content="{ui:Loc 'Adopt installed mods…'}" ui:Icon.Glyph="&#xE7B3;"
                        Command="{Binding ScanForAdoptionCommand}"
                        ToolTip="{ui:Loc 'Finds mods that are already in the game but not in this list, and takes them over where they are'}" />
            </StackPanel>
        </Grid>

        <!-- The mod the app recommends for this game, apart from the player's own mods. -->
        <Border Margin="0,26,0,0" Style="{StaticResource Card}" Padding="0"
                Background="{StaticResource Brush.InfoPanel}" BorderBrush="{StaticResource Brush.InfoLine}"
                Visibility="{Binding HasRecommended, Converter={StaticResource Visible}}">
            <StackPanel>
                <DockPanel Margin="22,16">
                    <Button DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource Button.Primary}"
                            Content="{Binding RecommendedActionText}" ui:Icon.Glyph="&#xE896;" Command="{Binding InstallRecommendedCommand}"
                            Visibility="{Binding HasRecommendedAction, Converter={StaticResource Visible}}" />
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Overline}" Text="{Binding RecommendedLabel, Converter={StaticResource Tracked}}" />
                            <Button Margin="14,0,0,0" Style="{StaticResource Button.StatusBox}" Command="{Binding ShowRecommendedNotesCommand}"
                                    Foreground="{StaticResource Brush.Info}" BorderBrush="{StaticResource Brush.Info}" Background="{StaticResource Brush.InfoWash}"
                                    Visibility="{Binding HasRecommendedNotes, Converter={StaticResource Visible}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Text.Icon}" FontSize="12" Text="&#xE946;" />
                                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" Text="{ui:Loc 'TECHNICAL NOTES'}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Title}" Text="{Binding RecommendedName}"
                                   Visibility="{Binding ShowRecommendedName, Converter={StaticResource Visible}}" />
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Body}" Text="{Binding RecommendedText}"
                                   Visibility="{Binding HasRecommendedText, Converter={StaticResource Visible}}" />
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Small}" TextTrimming="None" TextWrapping="Wrap"
                                   Text="{Binding RecommendedStatusText}"
                                   Visibility="{Binding HasRecommendedStatus, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </DockPanel>
                <StackPanel Visibility="{Binding IsRecommendedInstalled, Converter={StaticResource Visible}}">
                    <Border Style="{StaticResource Divider}" />
                    <ContentControl Focusable="False" Content="{Binding RecommendedItem}" ContentTemplate="{StaticResource ModRow}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Search -->
        <DockPanel Margin="0,26,0,12">
            <Button DockPanel.Dock="Right" Margin="10,0,0,0" Content="{ui:Loc 'Test without mods'}" ui:Icon.Glyph="&#xE7E8;"
                    Command="{Binding TestWithoutModsCommand}" IsEnabled="{Binding CanTestWithoutMods}" ToolTipService.ShowOnDisabled="True"
                    ToolTip="{ui:Loc 'Turns every mod off and remembers which ones were on, to see whether the game runs without them. One click turns them back on.'}" />
            <Button DockPanel.Dock="Right" Margin="10,0,0,0" Content="{ui:Loc 'Mod sets…'}" ui:Icon.Glyph="&#xE81E;"
                    Command="{Binding ShowModSetsCommand}" ToolTip="{ui:Loc 'Save the mods that are on as a set, and turn on a set with one click'}" />
            <Border DockPanel.Dock="Right" Margin="10,0,0,0" Style="{StaticResource FieldBox}">
                <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Small}" Text="{Binding ModsCountText}" />
            </Border>
            <Button DockPanel.Dock="Right" Margin="10,0,0,0" Content="{ui:Loc 'Refresh'}" ui:Icon.Glyph="&#xE72C;"
                    Command="{Binding RefreshCommand}" ToolTip="F5" />
            <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Ctrl+F"
                     Tag="{ui:Loc 'Filter: mod name, version, PAK / IoStore, or file name'}" />
        </DockPanel>

        <!-- A test without mods is on -->
        <Border Margin="0,0,0,12" Style="{StaticResource Card}" Padding="22,16"
                Visibility="{Binding IsTestingWithoutMods, Converter={StaticResource Visible}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource Button.Primary}"
                        Content="{ui:Loc 'Turn them back on'}" ui:Icon.Glyph="&#xE7A7;" Command="{Binding TurnModsBackOnCommand}" />
                <TextBlock DockPanel.Dock="Left" Margin="0,0,16,0" Style="{StaticResource Text.Icon}" FontSize="18"
                           Foreground="{StaticResource Brush.Warning}" Text="&#xE7E8;" />
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding TestText}" />
                    <TextBlock Margin="0,3,0,0" Style="{StaticResource Text.Small}" TextWrapping="Wrap"
                               Text="{ui:Loc 'Start the game and see whether the problem stays. UE4SS itself and files you put into the game by hand stay in place.'}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Table -->
        <Border x:Name="Table" Style="{StaticResource Card}" Padding="0" SizeChanged="OnTableSizeChanged">
            <StackPanel>
                <Grid Margin="22,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{DynamicResource Col.Status}" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{DynamicResource Col.Type}" />
                        <ColumnDefinition Width="{DynamicResource Col.Integrity}" />
                        <ColumnDefinition Width="{DynamicResource Col.Date}" />
                        <ColumnDefinition Width="{DynamicResource Col.Actions}" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Text.Caption}" Text="{ui:Loc 'Status', Tracked=True}" Visibility="{DynamicResource Mods.WideOnly}" />
                    <Button Grid.Column="1" Style="{StaticResource Button.SortHeader}" Content="{ui:Loc 'Mod', Tracked=True}"
                            Tag="{Binding NameSortGlyph}" ToolTip="{ui:Loc 'Sort by name'}"
                            Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:ModSortField.Name}" />
                    <TextBlock Grid.Column="2" Style="{StaticResource Text.Caption}" Text="{ui:Loc 'Type', Tracked=True}" />
                    <TextBlock Grid.Column="3" Style="{StaticResource Text.Caption}" Text="{ui:Loc 'Integrity', Tracked=True}" Visibility="{DynamicResource Mods.WideOnly}" />
                    <Button Grid.Column="4" Style="{StaticResource Button.SortHeader}" Content="{ui:Loc 'Installed', Tracked=True}" Visibility="{DynamicResource Mods.WideOnly}"
                            Tag="{Binding InstalledSortGlyph}" ToolTip="{ui:Loc 'Sort by installation date'}"
                            Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:ModSortField.Installed}" />
                </Grid>
                <Border Style="{StaticResource Divider}" />

                <ItemsControl ItemsSource="{Binding ModsView}" Focusable="False" ItemTemplate="{StaticResource ModRow}" />

                <StackPanel Margin="0,52" HorizontalAlignment="Center"
                            Visibility="{Binding ShowEmpty, Converter={StaticResource Visible}}">
                    <ContentControl Style="{StaticResource BrandMark}" Width="40" Height="40" Opacity="0.5" />
                    <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" Style="{StaticResource Text.Title}" Text="{Binding EmptyTitle}" />
                    <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" Style="{StaticResource Text.Body}" Text="{Binding EmptyHint}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Files the manager did not place -->
        <Border Margin="0,16,0,0" Style="{StaticResource Card}" Padding="22,16"
                Visibility="{Binding HasUnmanaged, Converter={StaticResource Visible}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" VerticalAlignment="Center" Content="{ui:Loc 'Open mods folder'}"
                        ui:Icon.Glyph="&#xE838;" Command="{Binding OpenModFolderCommand}" />
                <Button DockPanel.Dock="Right" Margin="0,0,8,0" VerticalAlignment="Center" Content="{ui:Loc 'Refresh'}"
                        ui:Icon.Glyph="&#xE72C;" Command="{Binding RefreshCommand}" />
                <TextBlock DockPanel.Dock="Left" Margin="0,0,16,0" Style="{StaticResource Text.Icon}" FontSize="18"
                           Foreground="{StaticResource Brush.Warning}" Text="&#xE7BA;" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold" Text="{Binding UnmanagedText}" />
                    <TextBlock Margin="0,3,0,0" Style="{StaticResource Text.Small}"
                               Text="{ui:Loc 'The manager never changes or removes them.'}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </StackPanel>
</UserControl>
